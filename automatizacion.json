    {
      "parameters": {
        "jsCode": "// 1. Obtener todas las filas de la planilla\nconst items = $input.all();\n\n// 2. Extraer y limpiar los importes que pagan los afiliados\nconst importes = items.map(item => {\n  let val = item.json['IMPORTE AFILIADO'] || item.json['IMPORTE_num'] || '0';\n  if (typeof val === 'string') {\n    val = val.replace('$', '').replace(/\\./g, '').replace(',', '.').trim();\n  }\n  return parseFloat(val);\n}).filter(v => !isNaN(v));\n\n// 3. Extraer y limpiar los precios de lista (PVP)\nconst pvps = items.map(item => {\n  let val = item.json['PVP PAMI AL 01/10/2026'] || item.json['PVP_num'] || '0';\n  if (typeof val === 'string') {\n    val = val.replace('$', '').replace(/\\./g, '').replace(',', '.').trim();\n  }\n  return parseFloat(val);\n}).filter(v => !isNaN(v));\n\n// 4. Cálculos estadísticos clave\nconst totalRegistros = items.length;\nconst promedioPagar = Math.round(importes.reduce((a, b) => a + b, 0) / (importes.length || 1));\nconst promedioPVP = Math.round(pvps.reduce((a, b) => a + b, 0) / (pvps.length || 1));\nconst ahorroPromedio = promedioPVP - promedioPagar;\n\n// 5. Devolver un objeto consolidado\nreturn [{\n  json: {\n    total_medicamentos: totalRegistros,\n    pvp_promedio: promedioPVP,\n    gasto_promedio_afiliado: promedioPagar,\n    ahorro_promedio_pami: ahorroPromedio,\n    fecha_reporte: new Date().toLocaleDateString('es-AR')\n  }\n}];"
      },
